package {{PACKAGE}}

import android.app.Application
import androidx.compose.ui.test.junit4.createComposeRule
import androidx.compose.ui.test.onRoot
import com.github.takahirom.roborazzi.captureRoboImage
import org.junit.Rule
import org.junit.Test
import org.junit.runner.RunWith
import org.robolectric.ParameterizedRobolectricTestRunner
import org.robolectric.annotation.Config
import org.robolectric.annotation.GraphicsMode
import sergio.sastre.composable.preview.scanner.android.AndroidComposablePreviewScanner
import sergio.sastre.composable.preview.scanner.android.AndroidPreviewInfo
import sergio.sastre.composable.preview.scanner.core.preview.ComposablePreview

// Generated by LukeNeedham/ci-workflows (scripts/screenshots, docs/screenshots.md): do not copy this into the app.
// Renders every composable named <Name>PageContentScreenshot to docs/screenshots/<Name>.png.
@RunWith(ParameterizedRobolectricTestRunner::class)
@GraphicsMode(GraphicsMode.Mode.NATIVE)
// A plain Application: the app's own usually starts Koin, which fails the second time it is created
@Config(sdk = [34], qualifiers = "w360dp-h800dp-xxhdpi", application = Application::class)
class PageScreenshotTest(private val preview: ComposablePreview<AndroidPreviewInfo>) {

    @get:Rule
    val composeRule = createComposeRule()

    @Test
    fun render() {
        composeRule.setContent { preview() }
        // The tests run in the app module's directory
        composeRule.onRoot().captureRoboImage("../docs/screenshots/${preview.methodName.removeSuffix(SUFFIX)}.png")
    }

    companion object {
        private const val SUFFIX = "PageContentScreenshot"

        @JvmStatic
        @ParameterizedRobolectricTestRunner.Parameters(name = "{0}")
        fun previews(): List<Array<Any>> =
            AndroidComposablePreviewScanner()
                .scanPackageTrees("{{PACKAGE}}")
                .includePrivatePreviews()
                .getPreviews()
                .filter { it.methodName.endsWith(SUFFIX) }
                .map { arrayOf(it) }
    }
}
