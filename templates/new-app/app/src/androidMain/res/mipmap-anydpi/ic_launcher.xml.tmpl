<?xml version="1.0" encoding="utf-8"?>
<!-- The icon below Android 8 (API 26), which has no adaptive icons: the background and the foreground, as one square. The adaptive
     icon is in mipmap-anydpi-v26: an adaptive icon in a folder without the version fails the build for a minSdk under 26. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
