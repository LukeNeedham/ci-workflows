package __PACKAGE__

import android.app.Application
import __PACKAGE__.di.appModule
import com.lukeneedham.common.DebugKit
import com.lukeneedham.common.DebugKitConfig
import org.koin.android.ext.koin.androidContext
import org.koin.core.context.startKoin

class App : Application() {
    override fun onCreate() {
        super.onCreate()
        // First, so that the logger and the crash handler are there for everything after it
        DebugKit.init(DebugKitConfig(enabled = BuildConfig.DEBUG))
        startKoin {
            androidContext(this@App)
            modules(appModule)
        }
    }
}
