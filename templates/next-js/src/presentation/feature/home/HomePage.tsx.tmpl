'use client'

import { HomePageContent } from '@/presentation/feature/home/HomePageContent'
import { useHomeViewModel } from '@/presentation/feature/home/useHomeViewModel'

/** Connects the home page to the app: it gets the state of the view model and hands it down. No UI of its own. */
export function HomePage() {
  const { uiState, onButtonClick } = useHomeViewModel()
  return <HomePageContent uiState={uiState} onButtonClick={onButtonClick} />
}
